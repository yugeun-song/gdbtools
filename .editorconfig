root = true

[*]
charset = utf-8
end_of_line = lf

[*.{py,sh,bash}]
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
max_line_length = 120

[[shell]]
shell_variant = bash
indent_style = space
indent_size = 4
binary_next_line = true
switch_case_indent = true
